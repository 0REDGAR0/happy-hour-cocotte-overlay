<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base black -->
    <item>
        <shape>
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Subtle red radial glow from top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="20%"
                android:centerY="30%"
                android:startColor="#44B03A2E"
                android:centerColor="#11B03A2E"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Subtle red radial glow from bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="50%"
                android:centerY="90%"
                android:startColor="#33B03A2E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>