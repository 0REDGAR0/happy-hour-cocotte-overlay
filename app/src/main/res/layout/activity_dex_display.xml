<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cocotte_bg_warm"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/happy_hour_title"
        android:textColor="@color/cocotte_accent_main"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/happy_hour_subtitle"
        android:textColor="@color/cocotte_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/timer_default"
        android:textColor="@color/cocotte_mocha"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Drinks List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drink 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/drink_1"
                android:textColor="@color/cocotte_text_main"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvDrink1Old"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_1_old"
                android:textColor="@color/cocotte_text_secondary"
                android:textSize="14sp"
                android:layout_marginEnd="12dp" />
            <TextView
                android:id="@+id/tvDrink1New"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_1_new"
                android:textColor="@color/cocotte_accent_main"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Drink 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/drink_2"
                android:textColor="@color/cocotte_text_main"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvDrink2Old"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_2_old"
                android:textColor="@color/cocotte_text_secondary"
                android:textSize="14sp"
                android:layout_marginEnd="12dp" />
            <TextView
                android:id="@+id/tvDrink2New"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_2_new"
                android:textColor="@color/cocotte_accent_main"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Drink 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/drink_3"
                android:textColor="@color/cocotte_text_main"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvDrink3Old"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_3_old"
                android:textColor="@color/cocotte_text_secondary"
                android:textSize="14sp"
                android:layout_marginEnd="12dp" />
            <TextView
                android:id="@+id/tvDrink3New"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_3_new"
                android:textColor="@color/cocotte_accent_main"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Drink 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/drink_4"
                android:textColor="@color/cocotte_text_main"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvDrink4Old"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_4_old"
                android:textColor="@color/cocotte_text_secondary"
                android:textSize="14sp"
                android:layout_marginEnd="12dp" />
            <TextView
                android:id="@+id/tvDrink4New"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_4_new"
                android:textColor="@color/cocotte_accent_main"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Drink 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/drink_5"
                android:textColor="@color/cocotte_text_main"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvDrink5Old"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_5_old"
                android:textColor="@color/cocotte_text_secondary"
                android:textSize="14sp"
                android:layout_marginEnd="12dp" />
            <TextView
                android:id="@+id/tvDrink5New"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drink_5_new"
                android:textColor="@color/cocotte_accent_main"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
