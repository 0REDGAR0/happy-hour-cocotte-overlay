<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dex_main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 1. PRE_MATCH (Full Screen PNG Template) -->
    <include
        layout="@layout/overlay_pre_match"
        android:id="@+id/layer_pre_match"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 2. MATCH_LIVE (Discreet - No Scoreboard) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layer_match_live"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <!-- Discreet layer for Match Live - Scoreboard removed as per request -->
        <TextView
            android:id="@+id/tvMatchLiveDebugBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEBUG: MATCH LIVE ACTIVE"
            android:textColor="#40FFFFFF"
            android:textSize="10sp"
            android:layout_margin="10dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. HALF_TIME (PNG Template + Dynamic Content) -->
    <!-- HALF_TIME : ces vues utilisent uniquement les dimensions half_time_* -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layer_half_time"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/half_time"
            android:contentDescription="Half Time Template" />

        <TextView
            android:id="@+id/tvHalfHomeScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/terracotta"
            android:textSize="@dimen/half_time_score_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/half_time_score_home_margin_top"
            android:layout_marginStart="@dimen/half_time_score_home_margin_start" />

        <TextView
            android:id="@+id/tvHalfAwayScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/terracotta"
            android:textSize="@dimen/half_time_score_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/half_time_score_away_margin_top"
            android:layout_marginStart="@dimen/half_time_score_away_margin_start" />

        <TextView
            android:id="@+id/tvHalfHomeTeamName"
            android:layout_width="@dimen/half_time_home_team_name_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="DOMICILE"
            android:textColor="@color/pre_match_cream"
            android:textSize="@dimen/half_time_team_names_text_size"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/half_time_home_team_name_margin_top"
            android:layout_marginStart="@dimen/half_time_home_team_name_margin_start" />

        <TextView
            android:id="@+id/tvHalfAwayTeamName"
            android:layout_width="@dimen/half_time_away_team_name_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EXTERIEUR"
            android:textColor="@color/pre_match_cream"
            android:textSize="@dimen/half_time_team_names_text_size"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/half_time_away_team_name_margin_top"
            android:layout_marginStart="@dimen/half_time_away_team_name_margin_start" />

        <LinearLayout
            android:id="@+id/containerHalfTimeDrinks"
            android:layout_width="@dimen/half_time_drinks_width"
            android:layout_height="@dimen/half_time_drinks_height"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/half_time_drinks_margin_top"
            android:layout_marginEnd="@dimen/half_time_drinks_margin_end">

            <TextView
                android:id="@+id/tvHalfTimeDrinkCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chargement..."
                android:gravity="center"
                android:textColor="@color/pre_match_dark_text"
                android:textSize="@dimen/half_time_drinks_text_size"
                android:fontFamily="monospace"
                android:lineSpacingExtra="8dp" />
        </LinearLayout>

        <!-- Spotify in Half Time -->
        <LinearLayout
            android:layout_width="@dimen/match_fullscreen_music_width"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/match_fullscreen_music_margin_start"
            android:layout_marginBottom="@dimen/match_fullscreen_music_margin_bottom">
            <TextView android:id="@+id/tvHalfSpotifyTrack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tvHalfSpotifyArtist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/cocotte_beige" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. FULL_TIME (PNG Template + Dynamic Content) -->
    <!-- FULL_TIME : ces vues utilisent uniquement les dimensions full_time_* -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layer_full_time"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/full_time"
            android:contentDescription="Full Time Template" />

        <TextView
            android:id="@+id/tvFullHomeScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/terracotta"
            android:textSize="@dimen/full_time_score_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/full_time_score_home_margin_top"
            android:layout_marginStart="@dimen/full_time_score_home_margin_start" />

        <TextView
            android:id="@+id/tvFullAwayScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/terracotta"
            android:textSize="@dimen/full_time_score_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/full_time_score_away_margin_top"
            android:layout_marginStart="@dimen/full_time_score_away_margin_start" />

        <!-- Team names placed side-by-side below scores -->
        <TextView
            android:id="@+id/tvFullHomeTeamName"
            android:layout_width="@dimen/full_time_home_team_name_width"
            android:layout_height="wrap_content"
                        android:gravity="center"
            android:text="DOMICILE"
            android:textColor="@color/pre_match_cream"
            android:textSize="@dimen/full_time_team_names_text_size"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/full_time_home_team_name_margin_top"
            android:layout_marginStart="@dimen/full_time_home_team_name_margin_start" />

        <TextView
            android:id="@+id/tvFullAwayTeamName"
            android:layout_width="@dimen/full_time_away_team_name_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EXTERIEUR"
            android:textColor="@color/pre_match_cream"
            android:textSize="@dimen/full_time_team_names_text_size"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/full_time_away_team_name_margin_top"
            android:layout_marginStart="@dimen/full_time_away_team_name_margin_start" />

        <!-- Spotify in Full Time -->
        <LinearLayout
            android:layout_width="@dimen/match_fullscreen_music_width"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/match_fullscreen_music_margin_start"
            android:layout_marginBottom="@dimen/match_fullscreen_music_margin_bottom">
            <TextView android:id="@+id/tvFullSpotifyTrack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tvFullSpotifyArtist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/cocotte_beige" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Legacy / Hidden layer kept for minimal compatibility if needed -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layer_fullscreen" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <ImageView android:id="@+id/ivFullscreenTemplate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" android:contentDescription="" />
        <TextView android:id="@+id/tvFullTitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <TextView android:id="@+id/tvFullTeams" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <TextView android:id="@+id/tvFullScore" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <TextView android:id="@+id/tvFullInfo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <TextView android:id="@+id/tvFullHomeTeam" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <TextView android:id="@+id/tvFullAwayTeam" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 5. FULLSCREEN_MESSAGE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layer_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="60dp"
            android:text="MESSAGE"
            android:textColor="@color/white"
            android:textSize="56sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- V4: HAPPY HOUR ANNOUNCEMENT (5s Temporary) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layer_hh_announcement"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hh_announcement"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HAPPY HOUR"
                android:textColor="@color/white"
                android:textSize="@dimen/hh_announcement_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHHAnnouncementMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="La pinte est à 4€ au lieu de 9€"
                android:textColor="@color/cocotte_beige"
                android:textSize="@dimen/hh_announcement_msg_size"
                android:textStyle="italic" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 6. HAPPY HOUR BANNER (Bottom Overlap) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layer_happy_hour"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/hh_banner_height"
            android:background="@drawable/bg_banner_orange"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HAPPY HOUR"
                android:textColor="@color/white"
                android:textSize="@dimen/hh_banner_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHappyTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="05:00"
                android:textColor="@color/white"
                android:textSize="@dimen/hh_banner_timer_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBarOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="Prix réduits pendant 5 minutes !"
                android:textColor="@color/cocotte_beige"
                android:textSize="@dimen/hh_banner_msg_size"
                android:textStyle="italic" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 7. ERROR LAYER -->
    <LinearLayout
        android:id="@+id/layer_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROBLÈME DE CONNEXION"
            android:textColor="@color/terracotta"
            android:textSize="32sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentative de reconnexion au serveur..."
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- BANNER (Top floating) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layer_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_dark"
            android:padding="20dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="80dp">
            <TextView
                android:id="@+id/tvBannerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ANNONCE"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Global Connection Indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvConnectionError" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_panel_dark" android:padding="8dp" android:text="@string/connection_error_msg" android:textColor="@color/white" android:textSize="12sp" android:visibility="gone" android:layout_marginEnd="8dp" />
        <View android:id="@+id/connection_indicator" android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/ic_circle_indicator" />
    </LinearLayout>

    <!-- 8. FORCE DEBUG PANEL (Always on top if enabled) -->
    <TextView
        android:id="@+id/tvForceDebugPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#80FF0000"
        android:padding="8dp"
        android:text="OVERLAY ACTIF"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 9. SOUNDBOX FEEDBACK (Discreet toast) -->
    <TextView
        android:id="@+id/tvSoundFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:background="@drawable/bg_panel_dark"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="SON"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
