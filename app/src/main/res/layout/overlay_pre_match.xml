<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. FOND : Noir semi-transparent derrière le template -->
    <!-- Modifier android:background ici pour l'opacité globale (ex: #99000000 = 60%, #CC000000 = 80%) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_semi_transparent_black" />

    <!-- 2. TEMPLATE : Image pre_match.png à 100% d'opacité -->
    <ImageView
        android:id="@+id/ivPreMatchTemplate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/pre_match"
        android:contentDescription="Template PRE_MATCH" />

    <!-- 3. CONTENU DYNAMIQUE superposé -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ÉQUIPES : FRANCE / ITALIE -->
        <TextView
            android:id="@+id/tvHomeTeamName"
            android:layout_width="@dimen/pre_match_team_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ÉQUIPE 1"
            android:textColor="@color/pre_match_cream"
            android:textSize="@dimen/pre_match_team_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineCenterVertical"
            app:layout_constraintEnd_toEndOf="@+id/guidelineCenterVertical"
            android:layout_marginTop="@dimen/pre_match_team_top_margin_top"
            android:layout_marginStart="@dimen/pre_match_team_margin_start" />

        <TextView
            android:id="@+id/tvAwayTeamName"
            android:layout_width="@dimen/pre_match_team_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ÉQUIPE 2"
            android:textColor="@color/pre_match_cream"
            android:textSize="@dimen/pre_match_team_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/guidelineVS"
            app:layout_constraintStart_toStartOf="@+id/guidelineCenterVertical"
            app:layout_constraintEnd_toEndOf="@+id/guidelineCenterVertical"
            android:layout_marginTop="@dimen/pre_match_team_bottom_margin_top"
            android:layout_marginStart="@dimen/pre_match_team_margin_start" />

        <!-- TIMER : Compteur avant coup d'envoi -->
        <!-- TIMER : le point de départ horizontal est contrôlé par guidelineTimerStart. -->
        <!-- La marge pre_match_timer_margin_start ajoute un décalage vers la droite à partir de cette guideline. -->
        <!-- Si marginStart=0 est déjà trop à droite, il faut diminuer layout_constraintGuide_percent sur guidelineTimerStart. -->
        <TextView
            android:id="@+id/tvKickoffTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/pre_match_timer"
            android:textSize="@dimen/pre_match_timer_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/guidelineKickoff"
            app:layout_constraintStart_toStartOf="@+id/guidelineTimerStart"
            android:layout_marginTop="@dimen/pre_match_timer_margin_top"
            android:layout_marginStart="@dimen/pre_match_timer_margin_start" />

        <!-- MUSIQUE : modifier ici dans dimens.xml : pre_match_music_margin_start, pre_match_music_margin_bottom -->
        <LinearLayout
            android:id="@+id/containerSpotify"
            android:layout_width="@dimen/pre_match_music_width"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/pre_match_music_margin_start"
            android:layout_marginBottom="@dimen/pre_match_music_margin_bottom">

            <TextView
                android:id="@+id/tvSpotifyTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TITRE MUSIQUE"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/pre_match_music_title_size"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSpotifyArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARTISTE"
                android:textColor="@color/cocotte_beige"
                android:textSize="@dimen/pre_match_music_artist_size"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- PROGRAMME : modifier ici dans dimens.xml : pre_match_program_margin_top, pre_match_program_text_size -->
        <LinearLayout
            android:id="@+id/containerProgram"
            android:layout_width="@dimen/pre_match_program_width"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/pre_match_program_margin_top"
            android:layout_marginEnd="@dimen/pre_match_program_margin_end">

            <TextView
                android:id="@+id/tvProgramList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chargement..."
                android:textColor="@color/pre_match_cream"
                android:textSize="@dimen/pre_match_program_text_size"
                android:lineSpacingExtra="10dp" />
        </LinearLayout>

        <!-- BOISSONS : modifier ici dans dimens.xml : pre_match_drinks_margin_top, pre_match_drinks_margin_end, pre_match_drinks_width -->
        <!-- Note: Changement de logique de Bottom à Top pour un réglage plus facile -->
        <LinearLayout
            android:id="@+id/containerDrinks"
            android:layout_width="@dimen/pre_match_drinks_width"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/pre_match_drinks_margin_top"
            android:layout_marginEnd="@dimen/pre_match_drinks_margin_end">

            <TextView
                android:id="@+id/tvDrinkCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chargement..."
                android:textColor="@color/pre_match_dark_text"
                android:textSize="@dimen/pre_match_drinks_text_size"
                android:fontFamily="monospace"
                android:lineSpacingExtra="8dp" />
        </LinearLayout>

        <!-- Lignes directrices pour le placement (ne pas modifier sauf si nécessaire) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCenterVertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.54" />

        <!-- TIMER START GUIDELINE : diminue ce pourcentage pour déplacer la base du timer vers la gauche, augmente-le pour la déplacer vers la droite -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineTimerStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.41" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineVS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineKickoff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.58" />

        <!-- Views cachées pour la compatibilité (pochette, drapeaux) -->
        <ImageView android:id="@+id/ivAlbumArt" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <ImageView android:id="@+id/ivHomeFlag" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <ImageView android:id="@+id/ivAwayFlag" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
